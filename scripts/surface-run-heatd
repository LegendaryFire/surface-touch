#!/bin/sh
# surface-run-heatd — service entry point for the touchpad heat processor.
# Resolves the pad's hidraw node by identity (the node number can differ
# between boots), then execs heatd, which selects the heat stream with
# SET_FEATURE 0x05=1 on open and again after a resume or device reset.  If the pad is not present (mid-resume
# or driver unbound) this exits non-zero and the service restarts and
# retries a couple of seconds later.
set -eu

NODE=$("@LIBEXECDIR@/surface-resolve-hidraw" 045e 0c46 15) || {
	echo "surface-heatd: no touchpad hidraw node (045e:0c46) within 15 s" >&2
	exit 1
}

echo "surface-heatd: serving $NODE"
exec "@BINDIR@/heatd" --hidraw "$NODE"
