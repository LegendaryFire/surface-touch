#!/bin/sh
# surface-run-digid — service entry point for the digitizer processor
# (touchscreen + pen).  Resolves the digitizer's hidraw node by identity
# (the node number can differ between boots), derives the PCI function from
# sysfs, then execs digid, which arms the port with SET_FEATURE [05 01]
# on every open and reverts it at teardown.  If the digitizer is not
# present (mid-resume or driver unbound) this exits non-zero and the
# service restarts and retries a couple of seconds later.
set -eu

NODE=$("@LIBEXECDIR@/surface-resolve-hidraw" 045e 0c5d 15) || {
	echo "surface-digid: no digitizer hidraw node (045e:0c5d) within 15 s" >&2
	exit 1
}

BASE=${NODE##*/}
DEV=$(readlink -f "/sys/class/hidraw/$BASE/device") || {
	echo "surface-digid: $BASE vanished while resolving" >&2
	exit 1
}
BDF=$(echo "$DEV" | grep -oE '[0-9a-fA-F]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-9]' | head -1)
[ -n "$BDF" ] || {
	echo "surface-digid: no PCI parent under $DEV" >&2
	exit 1
}

echo "surface-digid: serving $NODE (pci $BDF)"
exec "@BINDIR@/digid" --live --bdf "$BDF"
