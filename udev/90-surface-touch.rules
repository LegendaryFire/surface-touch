# SPDX-License-Identifier: MIT
# 90-surface-touch.rules — Surface Laptop Studio 2 touch stack
#
# Match by the device's own HID identity, never by hidraw number: hidraw
# numbers are assigned at enumeration and differ between boots.
# HID_ID/modalias come from the devices' firmware-reported identity; the
# symlinks below give a stable name to what /dev/hidrawN only happens to be
# today.
#
# Identities:
#   045e:0c46  touchpad transport (the pad behind the THC SPI port)
#   045e:0c5d  digitizer transport (touchscreen + pen)
# The stack's own uhid devices (045e:4c46 pad front, 045e:4d54 touch front,
# 045e:5045 pen front) never match these rules.

# Stable names for the raw transports (debugging, diagnostics, scripts).
ACTION=="add", SUBSYSTEM=="hidraw", ENV{HID_ID}=="*:0000045E:00000C46", \
	TAG+="systemd", SYMLINK+="surface-thc-pad"
ACTION=="add", SUBSYSTEM=="hidraw", ENV{HID_ID}=="*:0000045E:00000C5D", \
	TAG+="systemd", SYMLINK+="surface-thc-digitizer"

# Start the processors when their device appears (boot and hotplug).  The services resolve the node again
# at each start and keep retrying, so no race with enumeration timing.
ACTION=="add", SUBSYSTEM=="hid", ENV{MODALIAS}=="*v0000045Ep00000C46", \
	TAG+="systemd", ENV{SYSTEMD_WANTS}+="surface-heatd.service"
ACTION=="add", SUBSYSTEM=="hid", ENV{MODALIAS}=="*v0000045Ep00000C5D", \
	TAG+="systemd", ENV{SYSTEMD_WANTS}+="surface-digid.service"
